{
  "name": "@stateforge-labs/herdr-sdk",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Typed client for the herdr socket API (protocol 22), generated from herdr's published schema.",
  "license": "MIT",
  "keywords": [
    "herdr",
    "herdr-core",
    "terminal-multiplexer",
    "coding-agents",
    "unix-socket",
    "json-rpc",
    "sdk",
    "typescript"
  ],
  "author": "stateforge-labs",
  "homepage": "https://github.com/stateforge-labs/herdr-sdk#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/stateforge-labs/herdr-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stateforge-labs/herdr-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "herdr": {
    "protocol": 22,
    "schemaVersion": 1,
    "testedWith": "0.9.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read-only": {
      "types": "./dist/read-only.d.ts",
      "default": "./dist/read-only.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./drift": {
      "types": "./dist/drift.d.ts",
      "default": "./dist/drift.js"
    },
    "./test-kit": {
      "types": "./dist/test-kit.d.ts",
      "default": "./dist/test-kit.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./core/test-kit": {
      "types": "./dist/core-test-kit.d.ts",
      "default": "./dist/core-test-kit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "schema",
    "skills",
    "docs/api",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "gen": "bun tools/gen/index.ts",
    "capture": "bun tools/scripts/capture-schema.ts",
    "test": "bun test",
    "test:gen": "bun test test/tools/gen",
    "check:pins": "bun tools/scripts/check-pins.ts",
    "lint:layers": "bun tools/scripts/check-layers.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "typecheck:types": "tsc -p test/types",
    "build:test": "tsc -p tsconfig.dist-test.json",
    "test:node": "bun run build:test && node --test --test-reporter=tap \"dist-test/test/herdr/wire/**/*.test.js\" \"dist-test/test/herdr/client/connect/**/*.test.js\" > dist-test/node-tap.txt; status=$?; cat dist-test/node-tap.txt; [ $status -eq 0 ] && grep -Eq \"^# tests [1-9]\" dist-test/node-tap.txt",
    "test:wire": "bun test test/herdr/wire test/herdr/client/connect",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build-test-kit.json && bun tools/scripts/rewrite-dts.ts",
    "prepack": "bun run build",
    "check:size": "bun run build && bun tools/scripts/check-size.ts",
    "pretest": "bun run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "bin": {
    "herdr-drift": "./bin/herdr-drift.js",
    "herdr-skill": "./bin/herdr-skill.js"
  }
}
