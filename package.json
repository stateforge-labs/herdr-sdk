{
  "name": "@homelab/herdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Typed client for the herdr socket API (protocol 22), generated from herdr's published schema.",
  "license": "MIT",
  "herdr": {
    "protocol": 22,
    "schemaVersion": 1,
    "testedWith": "0.9.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read-only": {
      "types": "./dist/read-only.d.ts",
      "default": "./dist/read-only.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./drift": {
      "types": "./dist/drift.d.ts",
      "default": "./dist/drift.js"
    },
    "./test-kit": {
      "types": "./dist/test-kit.d.ts",
      "default": "./dist/test-kit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "schema",
    "skills",
    "docs/api",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "gen": "bun gen/index.ts",
    "capture": "bun scripts/capture-schema.ts",
    "test": "bun test",
    "test:gen": "bun test test/gen",
    "check:pins": "bun scripts/check-pins.ts",
    "lint:layers": "bun scripts/check-layers.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "typecheck:types": "tsc -p test/types",
    "build:test": "tsc -p tsconfig.dist-test.json",
    "test:node": "bun run build:test && node --test \"dist-test/test/wire/**/*.test.js\" \"dist-test/test/connect/**/*.test.js\"",
    "test:wire": "bun test test/wire test/connect",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build-test-kit.json && bun scripts/rewrite-dts.ts",
    "prepack": "bun run build",
    "check:size": "bun run build && bun scripts/check-size.ts",
    "pretest": "bun run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "bin": {
    "herdr-drift": "./bin/herdr-drift.js",
    "herdr-skill": "./bin/herdr-skill.js"
  }
}
